<UserControl x:Name="iconPresenter"
             x:Class="ShaderPluginGUI.Controls.IconPresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShaderPluginGUI.Controls"
             mc:Ignorable="d" d:DesignHeight="64" d:DesignWidth="64"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="{x:Null}" Foreground="{x:Null}">

    <Viewbox Width="{Binding IconWidth, ElementName=iconPresenter}"
             Height="{Binding IconHeight, ElementName=iconPresenter}"
             SnapsToDevicePixels="True"
             RenderOptions.BitmapScalingMode="HighQuality">
        <ContentPresenter Content="{Binding Icon, ElementName=iconPresenter}"/>
    </Viewbox>
</UserControl>