<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/LabelStyle.xaml"/>
        <ResourceDictionary Source="/Styles/TextBoxStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="PixelInfo_CellBorderColorBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="PixelInfo_TableHeaderBackgroundBrush" Color="#FF404040"/>

    <Style x:Key="PixelInfo_LabelHeader" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0, 0, 0, 6"/>
    </Style>

    <Style x:Key="PixelInfo_TableBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FF303030"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="PixelInfo_RowLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="5, 2"/>
    </Style>

    <Style x:Key="PixelInfo_ColumnLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="8, 2"/>
    </Style>

    <Style x:Key="PixelInfo_CellTextBlock" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#FFF0F0F0"/>
        <Setter Property="Margin" Value="8, 2"/>
    </Style>
</ResourceDictionary>