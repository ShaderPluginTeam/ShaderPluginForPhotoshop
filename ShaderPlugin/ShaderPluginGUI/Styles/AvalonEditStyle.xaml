<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ShaderPluginGUI"
                    xmlns:controls="clr-namespace:ShaderPluginGUI.Controls"
                    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                    xmlns:folding="clr-namespace:ICSharpCode.AvalonEdit.Folding;assembly=ICSharpCode.AvalonEdit"
                    xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/Theme.xaml"/>
        <ResourceDictionary Source="/Styles/ButtonStyle.xaml"/>
        <ResourceDictionary Source="/Styles/CheckBoxStyle.xaml"/>
        <ResourceDictionary Source="/Styles/ContextMenuStyle.xaml"/>
        <ResourceDictionary Source="/Styles/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Text Editor -->
    <Style TargetType="{x:Type avalonEdit:TextEditor}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12pt"/>
        <Setter Property="Background" Value="{DynamicResource TextEditorBackgroundBrush}"/>
        <Setter Property="Foreground" Value="Gainsboro"/>
        <Setter Property="LineNumbersForeground" Value="#FF738795"/>
        <Setter Property="ShowLineNumbers" Value="True"/>
        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
    </Style>

    <Style x:Key="TextEditor.ReadOnly" TargetType="avalonEdit:TextEditor" BasedOn="{StaticResource {x:Type avalonEdit:TextEditor}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="ContextMenu" Value="{StaticResource ContextMenu.Text.ReadOnly}"/>
        <Setter Property="ShowLineNumbers" Value="False"/>
    </Style>

    <Style x:Key="TextEditor.ErrorWindow"  TargetType="avalonEdit:TextEditor" BasedOn="{StaticResource TextEditor.ReadOnly}">
        <Setter Property="FontSize" Value="13pt"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="Padding" Value="10, 5"/>
    </Style>

    <Style x:Key="TextEditor.SystemInfo"  TargetType="avalonEdit:TextEditor" BasedOn="{StaticResource TextEditor.ReadOnly}">
        <Setter Property="FontSize" Value="13pt"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="Padding" Value="10, 5"/>
    </Style>

    <!-- Text Selection -->
    <Style TargetType="{x:Type avalonEdit:TextArea}">
        <Setter Property="SelectionBrush" Value="#C0264F78"/>
        <Setter Property="SelectionForeground" Value="WhiteSmoke"/>
        <Setter Property="SelectionBorder">
            <Setter.Value>
                <Pen Brush="#FF146DC7" Thickness="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- HyperLinks color -->
    <Style TargetType="{x:Type avalonEdit:TextView}">
        <Setter Property="LinkTextForegroundBrush" Value="#FF23A9CC"/>
    </Style>

    <!-- Line Numbers -->
    <Style TargetType="{x:Type avalonEdit:LineNumberMargin}">
        <Setter Property="Margin" Value="5, 0, 2, 0"/>
    </Style>

    <!--  Folding Margin -->
    <Style TargetType="{x:Type folding:FoldingMargin}">
        <Setter Property="FoldingMarkerBrush" Value="#FFBBBBBB" />
        <Setter Property="SelectedFoldingMarkerBrush" Value="#FFEEEEEE" />
        <Setter Property="FoldingMarkerBackgroundBrush" Value="#FF101010" />
        <Setter Property="SelectedFoldingMarkerBackgroundBrush" Value="#FF404040"/>
    </Style>

    <!-- Search Panel -->
    <Style x:Name="SearchPanel" TargetType="{x:Type search:SearchPanel}">
        <Setter Property="Background" Value="#202020"/>
        <Setter Property="Foreground" Value="WhiteSmoke"/>
        <Setter Property="BorderBrush" Value="#C0C0C0"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="14"/>

        <Setter Property="MarkerBrush" Value="#FF453B32"/>
        <Setter Property="MarkerPen">
            <Setter.Value>
                <Pen Brush="#FFFFC700" Thickness="1"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type search:SearchPanel}">
                    <Border Background="#404040"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Cursor="Arrow"
                            Padding="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Name="PART_searchTextBox" Focusable="True" MinWidth="150" MaxWidth="400" Height="24"
                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="3, 0" Margin="3, 3, 1, 3">
                                <TextBox.Text>
                                    <Binding Path="SearchPattern" RelativeSource="{RelativeSource TemplatedParent}" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <ExceptionValidationRule />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <search:DropDownButton Height="24" Foreground="{TemplateBinding Foreground}">
                                <search:DropDownButton.DropDownContent>
                                    <Popup Name="PART_dropdownPopup"
                                           StaysOpen="False">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                Padding="2">
                                            <StackPanel Orientation="Vertical">
                                                <CheckBox Content="{Binding Localization.MatchCaseText, RelativeSource={RelativeSource TemplatedParent}}"
                                                          IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Margin="3"/>
                                                <CheckBox Content="{Binding Localization.MatchWholeWordsText, RelativeSource={RelativeSource TemplatedParent}}"
                                                          IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Margin="3"/>
                                                <CheckBox Content="{Binding Localization.UseRegexText, RelativeSource={RelativeSource TemplatedParent}}"
                                                          IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Margin="3"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </search:DropDownButton.DropDownContent>
                            </search:DropDownButton>

                            <Button Style="{StaticResource Button.RoundCornerSmall}" Width="24" Height="24" Margin="3"
                                    ToolTip="{Binding Localization.FindPreviousText, RelativeSource={RelativeSource TemplatedParent}}"
                                    Command="search:SearchCommands.FindPrevious">
                                <controls:IconPresenter Icon="{StaticResource Icon.Previous}" IconWidth="16" IconHeight="16"/>
                            </Button>
                            <Button Style="{StaticResource Button.RoundCornerSmall}" Width="24" Height="24" Margin="3"
                                    ToolTip="{Binding Localization.FindNextText, RelativeSource={RelativeSource TemplatedParent}}"
                                    Command="search:SearchCommands.FindNext">
                                <controls:IconPresenter Icon="{StaticResource Icon.Next}" IconWidth="16" IconHeight="16"/>
                            </Button>
                            <Button Style="{StaticResource Button.RoundCornerSmall}" Height="16" Width="16" Focusable="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
							        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                    Command="search:SearchCommands.CloseSearchPanel">
                                <Path Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1"
                                      Data="M 0,0 L 8,8 M 8,0 L 0,8"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search Panel DropDownButton -->
    <Style TargetType="{x:Type search:DropDownButton}">
        <Style.Resources>
            <SolidColorBrush x:Key="DropDownButton.ActiveBorder" Color="{StaticResource ComboBoxHeaderBorderColor}"/>
            <SolidColorBrush x:Key="DropDownButton.ActiveBackground" Color="{StaticResource ComboBoxHeaderBackgroundColor}"/>
        </Style.Resources>
        
        <Setter Property="Foreground" Value="{DynamicResource GlyphColor}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="search:DropDownButton">
                    <Border Name="OuterBorder"
						    Background="{TemplateBinding Background}"
						    BorderBrush="{TemplateBinding BorderBrush}"
						    BorderThickness="{TemplateBinding BorderThickness}"
						    SnapsToDevicePixels="True">
                        <Path Stretch="Fill" Width="8" Height="4" Margin="3"
							  Fill="{TemplateBinding Foreground}"
							  Data="M0,0 L1,0 0.5,1 z"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="OuterBorder" Value="{DynamicResource DropDownButton.ActiveBorder}" />
                            <Setter Property="Panel.Background" TargetName="OuterBorder" Value="{DynamicResource DropDownButton.ActiveBackground}"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="OuterBorder" Value="{DynamicResource DropDownButton.ActiveBorder}"/>
                            <Setter Property="Panel.Background" TargetName="OuterBorder" Value="{DynamicResource DropDownButton.ActiveBackground}"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="search:DropDownButton.IsDropDownContentOpen" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="OuterBorder" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            <Setter Property="Border.BorderThickness" TargetName="OuterBorder" Value="1,1,1,0" />
                            <Setter Property="Border.Padding" TargetName="OuterBorder" Value="0,0,0,1" />
                            <Setter Property="Panel.Background" TargetName="OuterBorder" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>