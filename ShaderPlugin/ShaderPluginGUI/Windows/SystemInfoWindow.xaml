<local:DarkWindow x:Class="ShaderPluginGUI.SystemInfoWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:ShaderPluginGUI"
                  xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                  mc:Ignorable="d"
                  Width="800" Height="600" WindowStartupLocation="CenterOwner"  ShowInTaskbar="False"
                  Title="System Info" Background="{DynamicResource WindowBackgroundBrush}" Icon="/Resources/WindowIcon.ico"
                  KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Theme.xaml"/>
                <ResourceDictionary Source="/Styles/AvalonEditStyle.xaml"/>
                <ResourceDictionary Source="/Styles/WindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <avalonEdit:TextEditor Name="textEditorInfo" Style="{StaticResource TextEditor.SystemInfo}" Margin="6, 0, 6, 6"
                           d:Text="System Info"/>
</local:DarkWindow>
